# Copy to .env and adjust: cp .env.example .env
# Never commit .env. Every setting below is optional except the admin password.

# --- Store and data ---------------------------------------------------------------
# Path to the DuckDB store (catalog, results, boundaries, parcels).
PRECINCTMAP_DB_PATH=data/precinctmap.duckdb

# Root of raw/, staging/, boundaries/, samples/.
PRECINCTMAP_DATA_DIR=data

# County whose results and boundaries are loaded.
PRECINCTMAP_COUNTY=Franklin

# Built web client served by the API; leave unset in development (Vite serves it).
# The Docker image sets it to /app/static.
# PRECINCTMAP_STATIC_DIR=/app/static

# Directory holding a preinstalled DuckDB spatial extension (offline installs; the Docker
# image sets it). Unset = DuckDB downloads the extension on first use.
# PRECINCTMAP_DUCKDB_EXT_DIR=/opt/duckdb_ext

# --- Admin login (required for /admin and /api/ingest; the map itself is public) -----
# Use a long random password (12+ characters); placeholders such as "changeme" are refused.
PRECINCTMAP_ADMIN_USER=admin
PRECINCTMAP_ADMIN_PASSWORD=changeme

# --- Web client -------------------------------------------------------------------
# Organization name shown in the map header (applied at build time; blank = none).
VITE_ORG_NAME=

# --- Docker Compose ---------------------------------------------------------------
# Host port, bound to 127.0.0.1 (private by default; put a reverse proxy in front).
PRECINCTMAP_PORT=8000

# User and group the container runs as, so files in ./data stay owned by you (see `id -u`, `id -g`).
PRECINCTMAP_UID=1000
PRECINCTMAP_GID=1000

# --- Optional BigQuery sync -------------------------------------------------------
# Auth uses Application Default Credentials (gcloud auth application-default login),
# never a key file in the repo.
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
