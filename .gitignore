# Secrets
.env
.env.*
!.env.example

# Data: results, boundaries, the DuckDB store. Public data, but never committed.
# data/.gitkeep is tracked so a fresh clone has ./data owned by you (Docker would create it
# as root, and the container's user couldn't write the store).
data/*
!data/.gitkeep
*.duckdb
*.duckdb.wal

# Python
.venv/
__pycache__/
*.py[cod]
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/

# Web
node_modules/
dist/
app/web/coverage/
*.tsbuildinfo

# Local agent notes
CLAUDE.local.md

# OS / editor
.DS_Store
Thumbs.db
*:Zone.Identifier
.vscode/
.idea/
